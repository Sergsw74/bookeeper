__pycache__/
*.py[cod]
*$py.class
*.so

# 2. Python Virtual Environments
.venv/
venv/
env/
ENV/
.env
env.bak/
venv.bak/

# 3. Build Artifacts & Packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
develop-eggs/
downloads/
eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST

# 4. Cache Directories
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# 5. Testing & Coverage Artifacts
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
nosetests.xml

# 6. Calibre Test Database & Storage Artifacts
metadata.db
metadata_db_prefs_backup.json
calibre_test_library/
calibre_test_db/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# 7. Local Runtime, Logs & Export Output
config.yaml
data/
output/
obsidian_vault/
graph_exports/
logs/
*.log

# 8. OS & Editor Metadata
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
