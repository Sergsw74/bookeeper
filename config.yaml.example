# ==============================================================================
# bookeeper - Configuration File
# ==============================================================================

# Calibre Library Integration (local path or http://host:port/#library)
calibre_library_path: "~/Calibre Library"
calibre_user: null
calibre_password: null

# Local Ollama LLM & Embeddings Configuration
ollama_base_url: "http://localhost:11434"
llm_model: "llama3.1:8b"
embedding_model: "nomic-embed-text"

# Entity resolution cosine similarity threshold (0.0 - 1.0)
similarity_threshold: 0.85

# Destination directory for Knowledge Graph exports and Obsidian vaults
output_dir: "./output"
