# ==============================================================================
# bookeeper - Configuration File
# ==============================================================================

# Book Source Options
# ==============================================================================
# Option A: Folder of downloaded books/articles (e.g. from Archive Downloader)
# Point directly to a directory of PDFs/EPUBs (supports index.json and .opf metadata).
# If set, Bookkeeper uses this folder as its book source instead of Calibre database.
# books_dir: "archive_downloader/downloads"
books_dir: null

# Option B: Calibre Library Integration
# Supports:
# 1. Mounted SMB share: e.g. "/Volumes/Calibre Library" or "/Volumes/share/books"
# 2. Local folder path: e.g. "~/Calibre Library"
# 3. Remote Calibre Content Server: e.g. "http://192.168.50.20:8080/#library"
calibre_library_path: "/Volumes/Calibre Library"
calibre_user: null
calibre_password: null

# Database Staging & Safety
# Download/stage metadata.db locally for microsecond SSD transactions and sync back on completion
stage_metadata_db: true
backup_metadata_db: true

# Remote or Local Ollama LLM Configuration
# For single-server setups, set ollama_base_url:
ollama_base_url: "http://192.168.50.15:11434"
llm_model: "qwen2.5:3b"
llm_model_fallback: "llama3.1:8b"   # Optional fallback LLM model switched to after 50% chunk retries
request_timeout: 30       # HTTP timeout in seconds for LLM calls (prevents stuck workers)
max_retries: 1           # Retries for an attempt on an Ollama server before failover/skip (default: 1)
max_chunk_attempts: 6    # Maximum attempts across pool for a stalled chunk before marking failed (default: 6)
max_context_size: 5120   # Maximum combined chunk context size in bytes (default: 5KB) for simultaneous extraction
max_chunk_batch: 3       # Top limit on number of chunks combined per extraction task (default: 3)
# Chronological Ingestion & 3-Tier Semantic Chunk Routing Options
# Top-level shorthand (also configurable under 'recent_ideas:' block):
batch_books: 10          # Number of books grouped per chronological ingestion batch (default: 10)
similarity_unassigned_threshold: 0.65       # Chunks below this similarity (<0.65) treated as brand new ideas (Tier 1)
similarity_high_confidence_threshold: 0.90  # Chunks above this similarity (>=0.90) directly assigned to idea, skipping LLM (Tier 2)
skip_limbo_chunks: false                    # Skip limbo chunks (0.65 <= sim < 0.90) completely from LLM processing (Tier 3)
max_batch_chunk_size: null                  # If a limbo chunk is this size (chars) or larger, recover it from limbo into processing queue

# Alternatively, configure as structured section:
# recent_ideas:
#   enabled: true
#   batch_books: 10
#   similarity_unassigned_threshold: 0.65
#   similarity_high_confidence_threshold: 0.90
#   skip_limbo_chunks: false
#   max_batch_chunk_size: 500               # Recover limbo chunks >= 500 chars to unprocessed LLM queue

# Dedicated local or remote Embeddings endpoint (Recommended for maximum performance)
# Offloading embeddings to your local machine (e.g. Apple Silicon Mac on http://localhost:11434)
# prevents the remote Ollama server from unloading llama3.1 from VRAM to run nomic-embed-text,
# eliminating multi-second model-swapping latency and network delays.
# Set to "pool" (or leave null) to share the LLM multi-server pool for embeddings.
embedding_base_url: "http://localhost:11434"
embedding_model: "nomic-embed-text"

# Multi-server failover pool (N servers with priority ordering and capabilities)
# Each node can specify its capabilities: 'llm', 'embedding', 'verification'.
# If capability is omitted, the node supports all three tasks by default.
# Requests route to the highest priority available server matching the required task capability.
ollama_servers:
  - url: "http://192.168.50.118:11434"
    priority: 1
    name: "mypc-gpu-node"
    mac: "D8:43:AE:FA:44:95"        # Optional MAC address for Wake-on-LAN (WOL)
    wol_secret: null               # Optional WOL password/secret (e.g. 6-byte hex '01:02:03:04:05:06' or 4-byte/ASCII)
    capability: ["llm", "embedding", "verification"]
  - url: "http://192.168.50.15:11434"
    priority: 2
    name: "primary-gpu-node"
    capability: ["llm", "embedding"]
  - url: "http://localhost:11434"
    priority: 4
    name: "mac-node"
    capability: ["llm", "embedding"]
  - url: "http://192.168.50.20:11434"
    priority: 10
    name: "secondary-cpu-node"
    capability: ["embedding"]

# ==============================================================================
# Failover Cooldown Periods
# ==============================================================================
# Global default cooldown duration in seconds before retrying a failed server (default: 600s = 10 min)
failover_cooldown_seconds: 600

# Cooldown duration in seconds specifically for book analysis / extraction (default: 600s = 10 min).
# A longer timeout provides greater tolerance for high-volume note extraction and heavy chapter processing.
analysis_cooldown_seconds: 600

# Cooldown duration in seconds specifically for verification steps (default: 60s = 1 min).
# Verification involves fewer notes and quick audits, so retry attempts should be executed faster.
# Can also be placed under the 'verification:' block as 'cooldown_seconds'.
verification_cooldown_seconds: 60

# Wake-on-LAN (WOL) Configuration
# If an Ollama server is unreachable during warmup and has a configured MAC address,
# send a WOL magic packet and wait up to wol_wait_seconds (probing every wol_probe_interval) for it to boot.
wol_enabled: true
wol_wait_seconds: 120         # Up to 2 minutes waiting for machine to boot
wol_probe_interval: 5         # Poll every 5 seconds while waiting
wol_broadcast: "255.255.255.255"
wol_port: 9

# Parallel Task Pool across available Ollama servers
# Concurrency auto-scales across all alive servers (sequential 1 task per server):
#   active tasks = number of alive servers (1x per server)
#   Ollama processes data sequentially per server; tasks are submitted one by one per server
# Set max_active_tasks to an integer to fix concurrency, or leave null for auto-scaling
max_active_tasks: null
tasks_per_server: 1
max_active_tasks_cap: 10

# Entity resolution cosine similarity threshold (0.0 - 1.0)
similarity_threshold: 0.85

# Destination directory for Knowledge Graph exports and Obsidian vaults
output_dir: "./output"

# Optional path for progress checkpoint state file (defaults to output_dir/.bookeeper_state.json)
state_file: null

# ==============================================================================
# LightRAG Engine Configuration
# ==============================================================================
# Fast incremental graph-enhanced indexing and dual-level (local/global/hybrid) retrieval.
# Automatically distributes LLM synthesis and nomic-embed-text embeddings across the Ollama pool.
enable_lightrag: true
lightrag_dir: "./output/lightrag"
# Embedding dimension for LightRAG: 1024 for bge-m3 / bge-large, 768 for nomic-embed-text.
# Automatically auto-detected if dimension differs from Ollama server output.
lightrag_embedding_dim: 768
lightrag_mode: "hybrid"  # Default retrieval mode: 'hybrid', 'local', 'global', 'naive', or 'mix'

# Throughput, Concurrency & In-Memory Batching:
lightrag_max_parallel_insert: 6     # Number of documents/chunks parsed in parallel (default: 6)
lightrag_llm_max_async: 16          # Max concurrent entity/relation extraction calls to Ollama (default: 16)
lightrag_embedding_batch_num: 64    # Number of text chunks sent in a single batch to embedding endpoint (default: 64)
lightrag_embedding_max_async: 32    # Concurrent async embedding workers (default: 32)
lightrag_ollama_keep_alive: "-1"    # Ollama keep_alive parameter ('-1' keeps models pinned in RAM/VRAM)


# ==============================================================================
# Neo4j Graph Database Export Configuration
# ==============================================================================
# High-throughput graph database export with upsert semantics (MERGE).
# Automatically creates schema constraints and indexes on node IDs and updates
# existing nodes and relationships with new attributes without data duplication.
neo4j:
  enabled: false                      # Set to true to automatically upsert into Neo4j during build-graph
  uri: "bolt://localhost:7687"        # Neo4j Bolt or Neo4j protocol URI (e.g. bolt://192.168.50.20:7687 or neo4j+s://...)
  user: "neo4j"                       # Authentication username
  password: "password"                # Authentication password
  database: "neo4j"                   # Target Neo4j database name
  batch_size: 500                     # Cypher UNWIND transaction batch size
  clean_export: false                 # Set to true to perform a clean start (delete all content before export)

# ==============================================================================
# Dual-Pass Idea Aggregation & Synthesis Configuration
# ==============================================================================
# Automatically groups and aggregates semantically similar concepts across books,
# resolves aliases, and synthesizes unified multi-occurrence idea definitions.
dual_pass:
  enabled: true
  model: "llama3.1:8b"              # Dedicated model for consolidation (defaults to llm_model if omitted)
  similarity_threshold: 0.92        # Cosine similarity threshold for concept cluster merging
  max_quotes: 5                     # Maximum representative quotes retained per cluster
  min_occurrences: 2                # Minimum occurrences (N >= 2) to trigger LLM synthesis
  temperature: 0.1                  # Low temperature for precise synthesis
  state_file: null                  # Custom path for state checkpoint JSON (defaults to output_dir/.bookeeper_dual_pass_state.json)
  checkpoint_interval: 100          # Save postprocessing state checkpoint every N ideas
  async_save: true                  # Fast asynchronous non-blocking background checkpoint persistence

# ==============================================================================
# Multi-Verification Configuration
# ==============================================================================
# Array of verifiers with mode and specific parameters for each verifier.
# Automatically executed in sequence during 'test-run' or 'verify' without parameters.
# The first verifier in this list also serves as the default verifier settings.
verifiers:
  - mode: "ideas"
    model: "llama3.1:8b"              # Dedicated model for verification
    percent: 1.0                      # Sampling percentage of ideas (1.0 = 1%)
    temperature: 0.0                  # Low temperature for strict factual evaluation
    max_examples: 20                  # Maximum discrepancy examples to report
    cooldown_seconds: 60
  - mode: "chunking"
    distance_threshold: 0.20          # Cosine distance threshold for semantic chunk expansion
    max_examples: 20
  - mode: "kg"
    tau: 0.75                         # Semantic proximity radius threshold
    low_p10_prompt: false             # Set to true to generate ~1M prompt for frontier models auditing bottom p10 blind spots
    low_p10_output: null              # Optional destination path (default: output_dir/low_p10_verification_prompt.txt)

# Legacy single-verifier configuration (retained for backward compatibility;
# synchronized with the default verifier in verifiers list above).
verification:
  enabled: true
  model: "llama3.1:8b"              # Dedicated model for verification (e.g. llama3.1:8b, qwen2.5:7b-instruct)
  percent: 1.0                      # Default sampling percentage of ideas (1.0 = 1%)
  mode: "ideas"                     # Verification mode (default: 'ideas')
  temperature: 0.0                  # Low temperature for strict factual evaluation
  max_examples: 20                  # Maximum discrepancy examples to report
  cooldown_seconds: 60              # Cooldown period in seconds for verification (default: 60s; retries faster)
  tau: 0.75                         # Proximity threshold for 'kg'/'graph' mode
  low_p10_prompt: false             # Generate ~1M verification prompt for frontier models evaluating lowest-p10 tail chunks
  low_p10_output: null              # Optional destination path for low-p10 verification prompt

# ==============================================================================
# Section-Aware Hierarchical Semantic Cover Settings
# ==============================================================================
# Prunes redundant narrative elaborations and repetitive experimental tables within
# the same section/chapter, while preserving all novel conceptual contributions.
enable_hierarchical_cover: true
cover_similarity_threshold: 0.92        # Cosine similarity threshold (>=) within section to mark chunk redundant/covered
cover_window_size: 3                    # Number of recent section chunks to compare against (prevents distant paragraph absorption)
cover_min_section_chunks: 2             # Sections with fewer chunks are always kept (anchor preservation)
skip_references_sections: true          # Automatically bypasses References, Bibliography, and Boilerplate in scientific white papers

# ==============================================================================
# Token Usage & Financial Cost Estimation Settings
# ==============================================================================
# Token metrics are gathered across 4 segregated sections:
# 1. Tokens for embeddings
# 2. Input tokens (prompt)
# 3. Output tokens (completion)
# 4. Cache tokens (prompt cache read / hits)
#
# Statistics are persisted strictly in token counts inside output/token_usage_stats.json.
# Prices are NOT saved to the stats file; they are computed dynamically and printed
# in the terminal at the end of each session for human reliability and cost tracking.
#
# Optional custom unit rates (in USD per 1M tokens):
pricing:
  embedding: 0.02                   # Cost per 1M embedding tokens ($)
  input: 0.15                       # Cost per 1M input / prompt tokens ($)
  output: 0.60                      # Cost per 1M output / completion tokens ($)
  cache: 0.075                      # Cost per 1M prompt cache read tokens ($)

  # Optional custom comparative pricing tiers:
  # tier1:
  #   embedding: 0.02
  #   input: 0.14
  #   output: 0.28
  #   cache: 0.014
  # tier2:
  #   embedding: 0.10
  #   input: 0.15
  #   output: 0.60
  #   cache: 0.075
  # tier3:
  #   embedding: 0.15
  #   input: 2.50
  #   output: 10.00
  #   cache: 1.25
